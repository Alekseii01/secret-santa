# Participants, comma-separated. Names must be unique.
# Before anyone has drawn you can change the list: restart the server and the database follows.
NAMES=Anna,Bob,Vika,Greg

# Interface language: en or ru
LOCALE=en

# Port the server listens on
PORT=3000

# Where to keep the SQLite database (defaults to santa.db next to server.js)
# DB_PATH=/var/lib/santa/santa.db

# Key for admin requests (reset the draw, release a stuck name).
# Empty means admin requests are disabled. Generate one with: openssl rand -hex 24
ADMIN_KEY=
